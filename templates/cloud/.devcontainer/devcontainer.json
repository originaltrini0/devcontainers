{
  "name": "cloud",
  // General-purpose cloud CLI workspace. No custom image: cloud-tools is the
  // sole owner of the gcloud/aws/az/pwsh pins. Compose with terraform-tools
  // for infrastructure roots — e.g. google-cloud-foundations:
  //   "ghcr.io/originaltrini0/devcontainers/terraform-tools:1.0.7": { "flavor": "terraform" },
  //   "ghcr.io/originaltrini0/devcontainers/cloud-tools:1.0.7": { "az": "none", "pwsh": "none" }
  // Omitting options gets aws 2.40.3, az 2.92.0, pwsh 7.7.0, gcloud 593.0.0.
  // The feature ships with the next release tag; bump-version.sh rewrites the
  // pins below when the release line moves.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/originaltrini0/devcontainers/common:1.0.7": {},
    "ghcr.io/originaltrini0/devcontainers/cloud-tools:1.0.7": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock"
    // Prefer container-local cloud config so host tokens are never writable
    // from the container — point these at files or in-workspace dirs, e.g.:
    // "GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/<project>/.gcp/adc.json",
    // "AWS_SHARED_CREDENTIALS_FILE": "/workspaces/<project>/.aws/credentials",
    // "AWS_CONFIG_FILE": "/workspaces/<project>/.aws/config",
    // "AZURE_CONFIG_DIR": "/workspaces/<project>/.azure"
  },
  // Bind-mount host config dirs so VCS access works inside the container.
  // Every mount source must already exist on the host — Docker fails the whole
  // container if one is missing.
  "mounts": [
    // Kilo Code configuration
    "source=${localEnv:HOME}/.config/kilo,target=/home/vscode/.config/kilo,type=bind,readonly",
    "source=${localEnv:HOME}/.local/share/kilo,target=/home/vscode/.local/share/kilo,type=bind,consistency=cached",
    // Host SSH agent + config/known_hosts. sk-* keys live on the YubiKey, so only
    // the agent socket can sign; the .ssh mount provides ssh config only.
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly",
    // gh/glab API tokens (glab/gh auth login) persist across container rebuilds.
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/glab-cli,target=/home/vscode/.config/glab-cli,type=bind,consistency=cached"
    // Cloud credentials: mount host config read-ONLY (ADC/`aws sts`/`az account`
    // then work without the container writing host tokens), or drop these and
    // use the container-local paths above. Never a read-write cloud config dir.
    // "source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind,readonly",
    // "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,readonly",
    // "source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind,readonly"
  ],
  // Project-owned: add `git config --global --add safe.directory
  // /workspaces/<project>` as postCreateCommand when needed.
  "customizations": {
    "vscode": {
      "extensions": [
        "kilocode.kilo-code",
        "amazonwebservices.aws-toolkit-vscode",
        "ms-vscode.azurecli",
        "ms-vscode.powershell",
        "redhat.vscode-yaml"
      ]
    }
  }
}
